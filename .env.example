# collect2 — Konfiguration (env-Prefix COLLECT_, siehe src/collect/config.py)
# Kopieren nach .env; alle Werte optional, Defaults sind lokal-first.

# Daten-Substrat (bis zur Migration: Alt-Repo)
#COLLECT_DATA_DIR=/home/jnrabit/collect/data

# Modelle (Ollama, lokal). qwen2.5:7b passt GPU-only in 8GB VRAM.
#COLLECT_MAIN_MODEL=qwen2.5:7b
#COLLECT_CODE_MODEL=qwen2.5:7b
#COLLECT_OLLAMA_HOST=localhost
#COLLECT_OLLAMA_PORT=11434

# Query-Vorverarbeitung (kleine Modelle, Heuristik-gated — laufen selten)
#COLLECT_TRANSLATE_ENABLED=true
#COLLECT_TRANSLATE_MODEL=gemma2:2b
#COLLECT_DECOMPOSE_ENABLED=true
#COLLECT_DECOMPOSE_MODEL=qwen2.5:3b

# Embeddings — cpu default: die 8GB VRAM gehören vollständig der LLM
#COLLECT_EMBEDDING_DEVICE=cpu
#COLLECT_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Redis
#COLLECT_REDIS_HOST=localhost
#COLLECT_REDIS_PORT=6379
#COLLECT_REDIS_DB=0

# Drei-Zonen-Antwortlogik (TRUST: volle Antwort · bis SOFT_MAX: Hinweis
# "entfernte Treffer" · darüber: Hard Fallback)
#COLLECT_VAULT_TRUST_THRESHOLD=55.0
#COLLECT_VAULT_SOFT_MAX_DISTANCE=68.0
#COLLECT_CODE_VAULT_TRUST_THRESHOLD=62.0

# Code-Routing (Embedding-Centroid, Cosine)
#COLLECT_CODE_ROUTE_HIGH=0.40
#COLLECT_CODE_ROUTE_LOW=0.25
