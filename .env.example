# collect2 — Konfiguration (env-Prefix COLLECT_, siehe src/collect/config.py)
# Kopieren nach .env; alle Werte optional, Defaults sind lokal-first.

# Daten-Substrat (bis zur Migration: Alt-Repo)
#COLLECT_DATA_DIR=/home/jnrabit/collect/data

# DreamCycle: ab welcher Distanz-Streuung über die Treffer einer Query der
# Vault als widersprüchlich gilt (Rohstoff für die Meta-Kristallisation).
# Gemessen über 191 reale Queries: Median 6.8, p90 12.2, max 30.7.
# 14.0 → ~4% der Queries, 12.0 → ~11%, 10.0 → ~19%.
#COLLECT_DREAM_MIN_HIT_SPREAD=14.0

# Rollback-Punkte pro Vault-Datei, die ein Ingest behält (min. 1).
# Jeder Ingest sichert Archiv + Cache voll weg — beim General-Vault sind das
# ~490 MB pro Lauf. Höher setzen kostet linear Plattenplatz.
#COLLECT_INGEST_KEEP_BACKUPS=3

# Modelle (Ollama, lokal). qwen2.5:7b passt GPU-only in 8GB VRAM.
#COLLECT_MAIN_MODEL=qwen2.5:7b
#COLLECT_CODE_MODEL=qwen2.5:7b
#COLLECT_OLLAMA_HOST=localhost
#COLLECT_OLLAMA_PORT=11434

# Query-Vorverarbeitung (Heuristik-gated — laufen selten, gecacht)
#COLLECT_TRANSLATE_ENABLED=true
# DE→EN-Übersetzung: leer = main_model (qwen2.5:7b). Kleine Modelle
# (gemma2:2b/qwen2.5:3b) übersetzen Fachbegriffe falsch → korrumpiertes Retrieval.
#COLLECT_TRANSLATE_MODEL=
#COLLECT_DECOMPOSE_ENABLED=true
#COLLECT_DECOMPOSE_MODEL=qwen2.5:3b
#COLLECT_DECOMPOSE_MAX_SUBQUERIES=3   # max Teilfragen pro Query (RRF-Fusion)
#COLLECT_REWRITE_MAX_CONTENT_TERMS=6  # Referential-Gate: mehr Inhaltswörter = eigenständig

# Antwort-Umfang & Bus-Limits
#COLLECT_LLM_NUM_PREDICT=1024         # max generierte Tokens pro Antwort
#COLLECT_RETRIEVAL_MAX_HITS=8         # Hits pro Vault im Bus-Beitrag
#COLLECT_RETRIEVAL_MAX_CONTENT_CHARS=1600   # Zeichen pro Hit — MUSS >= LLM_DOC_CHARS sein!

# Embeddings — cpu default: die 8GB VRAM gehören vollständig der LLM
#COLLECT_EMBEDDING_DEVICE=cpu
#COLLECT_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Redis
#COLLECT_REDIS_HOST=localhost
#COLLECT_REDIS_PORT=6379
#COLLECT_REDIS_DB=0

# Drei-Zonen-Antwortlogik (TRUST: volle Antwort · bis SOFT_MAX: Hinweis
# "entfernte Treffer" · darüber: Hard Fallback). Kalibriert aufs
# deterministische Scoring — Messlatte: scripts/retrieval_benchmark.py
#COLLECT_VAULT_TRUST_THRESHOLD=50.0
#COLLECT_VAULT_SOFT_MAX_DISTANCE=62.0
#COLLECT_FALLBACK_SUPPRESS=true     # false = Antwort trotz FALLBACK zeigen (mit Warnhinweis)
#COLLECT_CODE_VAULT_TRUST_THRESHOLD=57.0

# Prompts: Overrides als <name>.txt (llm_system, session_summary, rewrite,
# translate, decompose, workflow_planning, workflow_codegen, workflow_repair).
# Vorlagen exportieren: python -m collect.prompts export data/prompts
# Invalide Dateien (fehlende Pflicht-/unbekannte Platzhalter) → eingebauter
# Prompt + Warnung. Leer = eingebaute Prompts.
#COLLECT_PROMPTS_DIR=data/prompts

# Erkennungs-Muster: Overrides als <name>.json (plan_detection, code_detection,
# profile_signals) — Routing-Wortlisten erweitern ohne Python-Edit.
# Vorlagen exportieren: python -m collect.patterns export data/patterns
# Invalide Dateien → eingebaute Listen + Warnung. Security-Patterns sind
# bewusst NICHT überschreibbar (Sicherheits-Gate bleibt im Code).
#COLLECT_PATTERNS_DIR=data/patterns

# Retrieval-Verhalten
#COLLECT_RETRIEVAL_DETERMINISTIC=true
#COLLECT_RETRIEVAL_PROFILE=auto        # auto, precise, balanced, broad, resonant, chaos, adaptive
#COLLECT_LEXICAL_RERANK_BOOST=10.0

# Retrieval-Scoring: Rohwerte (Score = α·cosine + β·thompson + γ·resonanz + δ·exploration)
# ACHTUNG: Die Zonen-Schwellen oben sind auf die Default-Gewichte kalibriert —
# wer α stark ändert, verschiebt die Zonen-Semantik (→ Benchmark neu laufen lassen).
#COLLECT_RETRIEVAL_ALPHA=0.80          # Basis-Gewichte (= 'balanced'-Preset)
#COLLECT_RETRIEVAL_BETA=0.05
#COLLECT_RETRIEVAL_GAMMA=0.10
#COLLECT_RETRIEVAL_DELTA=0.05
#COLLECT_RETRIEVAL_CHAOS_ALPHA=0.50    # Chaos-Modus (= 'chaos'-Preset)
#COLLECT_RETRIEVAL_CHAOS_BETA=0.20
#COLLECT_RETRIEVAL_CHAOS_GAMMA=0.20
#COLLECT_RETRIEVAL_CHAOS_DELTA=0.10
#COLLECT_RETRIEVAL_RRF_K=60            # Subquery-Fusion: kleiner = Top-Ränge dominieren
#COLLECT_RETRIEVAL_NO_HIT_DISTANCE=999.0
#COLLECT_RETRIEVAL_ADAPT_INTERVAL=50   # Lorenz-Adaption alle N Suchen
#COLLECT_RETRIEVAL_RESONANCE_ANCHORS=20
#COLLECT_RETRIEVAL_ADAPTIVE_EXPLORE_UNTIL=20   # adaptive-Profil: Phasen-Schwellen
#COLLECT_RETRIEVAL_ADAPTIVE_SETTLE_UNTIL=80
#COLLECT_RETRIEVAL_ENTROPY_MIX=[0.3,0.1,0.1,0.05]   # Chaos-Modus, JSON-Liste
#COLLECT_RESONANCE_DECAY=0.995         # Ko-Aktivierungs-Gedächtnis (→1.0 = länger)
#COLLECT_RETRIEVAL_PROFILE_OVERRIDES={"chaos": {"delta": 0.2}}   # JSON, mergt über Presets

# Code-Routing (Embedding-Centroid, Cosine)
#COLLECT_CODE_ROUTE_HIGH=0.40
#COLLECT_CODE_ROUTE_LOW=0.25

# ── REST-API / Web-Chat (src/collect/api.py, api_security.py) ──────────────
# Default: localhost-Bind, offen (Zero-Config, nur lokal erreichbar).
#COLLECT_API_HOST=127.0.0.1
#COLLECT_API_PORT=8767
# Auth: Token setzen → Bearer/?token= auf /api/query, /api/facts, /ws/chat
# erzwungen. Nicht-localhost-Bind OHNE Token verweigert der Preflight.
# Web-Chat: einmal http://host:8767/chat?token=DEIN_TOKEN öffnen (landet in
# localStorage). TLS terminiert ein Reverse-Proxy, NICHT die App.
#COLLECT_API_TOKEN=
#COLLECT_API_CORS_ORIGINS=          # leer = eigene localhost-Origin; sonst CSV
#COLLECT_API_RATE_EXPENSIVE=20      # query/ws: Aufrufe/Minute/Key
#COLLECT_API_RATE_LIGHT=120         # facts: Aufrufe/Minute/Key
#COLLECT_API_MAX_BODY_BYTES=65536   # Body-Cap (413 darüber)

# ── Ad-hoc-Dateikontext ("lies ~/x") ──────────────────────────────────────
# Allowlist fürs Datei-Lesen (CSV). Leer/ungesetzt = Executor-Grenzen
# (~/collect2, ~/collect). Erweiterung ist bewusster Opt-in — über die
# (ggf. exponierte) API ist das ein Datei-Lese-Endpoint.
#COLLECT_READ_PATHS=/home/jnrabit/projekte,/home/jnrabit/notizen
#COLLECT_FILE_CONTEXT_ENABLED=true
#COLLECT_FILE_MAX_BYTES=2000000
#COLLECT_FILE_MAX_FILES=25

# ── Code-Workflow: Idiom-System ─────────────────────────────────────────
#COLLECT_WORKFLOW_IDIOMS_ENABLED=true
#COLLECT_WORKFLOW_ENABLED=true      # false = Code-Tasks laufen als normale Wissensfrage
#COLLECT_PLANNING_ENABLED=true      # false = Plan-Vokabular startet keine Kaskade

# ── Sessions (persistente Gespräche) ─────────────────────────────────────
#COLLECT_SESSION_ENABLED=true
#COLLECT_SESSION_DB=~/collect2/data/sessions.db
#COLLECT_SESSION_MAX_TURNS=5
#COLLECT_SESSION_SUMMARY_MODEL=    # leer = decompose_model (qwen2.5:3b)

# ── Web-Recherche (SearXNG, selbst-gehostet) ─────────────────────────────
#COLLECT_WEB_SEARCH_ENABLED=true
#COLLECT_WEB_SEARCH_AUTO=false      # Opt-in: automatisch bei Vault-FALLBACK suchen
#COLLECT_WEB_SEARCH_AUTO_WITH_FILE=false   # true = Auto-Web trotz Datei-Kontext
#COLLECT_WEB_SEARCH_URL=http://localhost:8888
#COLLECT_WEB_SEARCH_RESULTS=5

# ── Qwythos-Serving (separater K4N0N3-Auftrag, Default aus) ──────────────
#COLLECT_QWYTHOS_ENABLED=false        # Modell-getriebener Agent statt Pipeline

# ── Trace-Pipeline (Trainingsdaten-Sammlung, CPU-only) ───────────────────
#COLLECT_TRACES_ENABLED=true          # Modellaufrufe als Traces mitschreiben
#COLLECT_TRACES_DIR=~/collect2/data/traces        # rotierende YYYY-MM-DD.jsonl
#COLLECT_TRACES_SEQ_LEN=2048          # Grenzwert für den Längen-Report
#COLLECT_TRACES_TOKENIZER=Qwen/Qwen2.5-7B-Instruct  # MUSS zum Inferenzmodell passen (Qwen3.5)
#COLLECT_WEB_SEARCH_MAX_SNIPPETS=6    # max Snippets im Web-Beitrag
#COLLECT_WEB_SEARCH_SNIPPET_CHARS=1200
#COLLECT_WEB_SEARCH_PAGE_FETCHES=2    # Top-N Seiten ganz abrufen (Page-Fetch)
#COLLECT_WEB_SEARCH_PAGE_CHUNK_CHARS=1000
#COLLECT_WEB_SEARCH_PAGE_TOP_CHUNKS=3
